# Base URL of the deployed FastAPI backend, INCLUDING the trailing /api prefix.
# Ask the backend developer for the deployed host. Examples:
#   https://uat.lmsai.saturnai.in/api      (UAT / non-production deployment)
#   https://lmsai.saturnai.in/api          (production)
#   http://localhost:5015/api              (backend running locally)
#
# Copy this file to `.env.local` and fill in the real value.
# NOTE: for cross-origin cookie auth to work from http://localhost:3000, the
# backend must (a) allow-list http://localhost:3000 in CORS and (b) run in a
# non-production mode so the auth cookie uses SameSite=none. Confirm with the dev.
NEXT_PUBLIC_API_BASE_URL=https://your-backend-host/api
